; Aether Valley — playable homestead build
config_version=5

[application]
config/name="Aether Valley"
run/main_scene="res://scenes/main.tscn"

[autoload]
SaveService="*res://scripts/save_service.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
tool_next={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
advance_day={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.18, 1)

[editor_plugins]
enabled=PackedStringArray("res://addons/aether_world_builder/plugin.cfg")
